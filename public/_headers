# La OG image exportada sale como application/octet-stream; los scrapers de
# WhatsApp/Twitter/Slack son estrictos con el MIME.
# OJO: una sola regla admite UN splat; el slug va como placeholder :slug.
/opengraph-image*
  Content-Type: image/png
  Cache-Control: public, max-age=86400
/guia/:slug/opengraph-image*
  Content-Type: image/png
  Cache-Control: public, max-age=86400
/og/*
  Content-Type: image/png
  Cache-Control: public, max-age=86400
